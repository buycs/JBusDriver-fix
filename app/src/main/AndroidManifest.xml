<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name="me.jbusdriver.common.AppContext"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        tools:replace="android:allowBackup"
        android:theme="@style/AppTheme.NoActionBar" >

        <meta-data
            android:name="android.max_aspect"
            android:value="2.2" />

        <!-- 友盟key -->
        <meta-data
            android:name="UMENG_APPKEY"
            android:value="${UMENG_KEY}" />
        <meta-data
            android:name="UMENG_CHANNEL"
            android:value="${CHANNEL}" />

        <activity
            android:name="me.jbusdriver.ui.activity.MainActivity"
            android:label="@string/app_name" />
        <activity
            android:name="me.jbusdriver.ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="me.jbusdriver.ui.activity.MovieDetailActivity" />
        <activity android:name="me.jbusdriver.ui.activity.WatchLargeImageActivity" />
        <activity android:name="me.jbusdriver.ui.activity.MovieListActivity" />
        <activity
            android:name="me.jbusdriver.ui.activity.SearchResultActivity"
            android:launchMode="singleTop" />
        <activity android:name="me.jbusdriver.ui.activity.SettingActivity" />
        <activity android:name="me.jbusdriver.ui.activity.ForumThreadActivity" />
        <activity android:name="me.jbusdriver.ui.activity.ForumThreadListActivity" />
        <!-- 播放页。旋转不重建: 重建会走 onDestroy → 播放器 release, 磁力那边还要重新拉一遍种子信息 -->
        <activity
            android:name="me.jbusdriver.ui.activity.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />
        <!-- 在线播放页。同样不因转屏重建: 重建会把 WebView 里正在跑的解析与已验证的会话一起丢掉 -->
        <activity
            android:name="me.jbusdriver.ui.activity.MissavPlayActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />

        <service
            android:name=".ui.task.LoadCollectService"
            android:exported="false" />
    </application>

</manifest>