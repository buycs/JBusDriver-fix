<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppTheme.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/material_8dp">

        <!-- 左列(人名+头像) 是第一个子项 = 右侧胶囊要绕开的那块。
             app:blockContentTop="true" 表示这块是「标题 + 内容」两段(人名 / 头像),
             胶囊区域因此与**头像**的上下边界对齐, 而不是与人名的顶部对齐:
             · 胶囊顶部与头像顶部齐平; 头像右侧那块区域被胶囊填满;
             · 只有在头像底部之上排不下时, 才换成整行(x 回到最左)往下排。
             人名用 match_parent + gravity=center: 左列宽度由头像决定, 所以人名正好居中在图片宽度上。
             app:blockWrapGap 是换成整行后与头像下沿留的空隙, 不给就贴着。
             头像高度不写死: 在 LinkedMovieListFragment 里按「4 行胶囊」实测出来再设,
             所以这里只固定宽度, 高度交给代码。 -->
        <me.jbusdriver.ui.widget.BlockFlowLayout
            android:id="@+id/fl_actress_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:blockContentTop="true"
            app:blockWrapGap="@dimen/material_8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/material_8dp"
                android:layout_marginTop="@dimen/material_6dp"
                android:orientation="vertical">

                <!-- 人名: 加粗、字号比正文大一档, 居中在头像宽度上 -->
                <TextView
                    android:id="@+id/tv_attr_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/primaryText"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="三上悠亜" />

                <!-- 四边 margin 由 AppTheme.CardView 提供(4dp), 别再写一遍 -->
                <androidx.cardview.widget.CardView
                    style="@style/AppTheme.CardView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_actress_avatar"
                        android:layout_width="@dimen/material_104dp"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        tools:src="@mipmap/ic_launcher" />

                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </me.jbusdriver.ui.widget.BlockFlowLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
