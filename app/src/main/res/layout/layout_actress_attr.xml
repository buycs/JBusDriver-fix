<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppTheme.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/material_8dp"
        android:layout_marginRight="@dimen/material_8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/material_8dp">

        <!-- 左列: 名称在上、头像在下 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_attr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/material_8dp"
                android:textColor="@color/primaryText"
                android:textSize="16sp"
                tools:text="三上悠亜" />

            <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                style="@style/AppTheme.CardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/material_8dp">


                <ImageView
                    android:id="@+id/iv_actress_avatar"
                    android:layout_width="@dimen/material_104dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:gravity="center"
                    android:scaleType="fitStart"
                    tools:src="@mipmap/ic_launcher" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <!-- 右列: 只放个人信息胶囊 -->
        <LinearLayout
            android:id="@+id/ll_attr_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 一行能放几个放几个, 放不下换行; 原来是一条一行, 九条就是九行 -->
            <me.jbusdriver.ui.widget.FlowLayout
                android:id="@+id/fl_actress_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

<!--    <ImageView
        android:id="@+id/iv_like_it"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/material_24dp"
        android:minWidth="@dimen/material_24dp"
        android:padding="@dimen/material_8dp"
        android:layout_gravity="top|right"
        android:tint="@color/colorAccent"
        android:src="@drawable/ic_love_sel"
        />-->


</androidx.cardview.widget.CardView>