<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_movie_forum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bubble_chart_black_24dp"
        android:tint="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/material_16dp"
        android:paddingStart="@dimen/material_16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recycle_forum_posts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_movie_forum_none_tip"
            style="@style/AppTheme.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="暂无論壇熱帖"
            android:textColor="@color/primaryText"
            android:visibility="gone" />

        <View style="@style/DividerLine.Horizontal" />
    </LinearLayout>
</LinearLayout>