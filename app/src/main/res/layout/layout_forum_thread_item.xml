<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp">

    <TextView
        android:id="@+id/tv_thread_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/forum_body"
        android:textSize="16sp" />

    <!-- 板块标签 + 回复浏览 + 楼主 + 时间挤在同一行: 楼主不再单独占一行, 条目少一行高度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 空板块标签必须 GONE: BRVAH 的 setVisible 走 INVISIBLE 会留下 20dp 空白把整行顶歪; setGone 的第二参数含义是「可见」 -->
        <TextView
            android:id="@+id/tv_thread_board"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/forum_board_tag_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/forum_board_tag"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_thread_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/forum_time"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_thread_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxWidth="140dp"
            android:singleLine="true"
            android:textColor="@color/forum_author"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_thread_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/forum_time"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/forum_divider" />
</LinearLayout>
