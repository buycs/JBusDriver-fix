<?xml version="1.0" encoding="utf-8"?>
<!--网格列数(2/3/4)下的影片条目: 封面在上, 标题和编号日期在下-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_movie_item"
    style="@style/AppTheme.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/material_6dp">

        <ImageView
            android:id="@+id/iv_movie_img"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,2:3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_place_holder" />

        <TextView
            android:id="@+id/tv_movie_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/material_4dp"
            android:layout_marginTop="@dimen/material_4dp"
            android:layout_marginRight="@dimen/material_4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/material_13sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_movie_img"
            tools:text="titletitletitletitletitletitle" />

        <TextView
            android:id="@+id/tv_movie_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/material_4dp"
            android:layout_marginTop="@dimen/material_2dp"
            android:layout_marginRight="@dimen/material_4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/secondText"
            android:textSize="@dimen/material_12sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_movie_title"
            tools:text="ABCD-123" />

        <TextView
            android:id="@+id/tv_movie_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/material_4dp"
            android:layout_marginTop="@dimen/material_2dp"
            android:layout_marginRight="@dimen/material_4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/secondText"
            android:textSize="@dimen/material_12sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_movie_code"
            tools:text="2026-09-24" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
