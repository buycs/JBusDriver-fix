<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="BlockFlowLayout">
        <!--
          左侧那块本身是「标题 + 内容」两段结构时置 true (女优页就是 人名 + 头像):
          胶囊区域改为与**内容**(那块里最后一个子项)的上下边界对齐,
          而不是与整块的上下边界对齐 —— 这样胶囊顶部才能和头像顶部齐平。
          默认 false, 即与整块对齐。
        -->
        <attr name="blockContentTop" format="boolean" />

        <!--
          换成整行模式(排到左侧那块下面)时, 整行第一行距左侧那块底部的空隙。
          默认 0 = 紧贴着排。女优页给 8dp, 免得胶囊贴着头像下沿。
        -->
        <attr name="blockWrapGap" format="dimension" />
    </declare-styleable>

</resources>
